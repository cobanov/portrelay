<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>PortRelay</vendor>
  <vendor_url>https://portrelay.cobanov.dev</vendor_url>
  <action id="dev.cobanov.portrelay.setup">
    <description>Enable USB sharing for this computer</description>
    <message>PortRelay needs permission to install USB support and enable its device service.</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/portrelay/setup-usb</annotate>
  </action>
  <action id="dev.cobanov.portrelay.setup-input">
    <description>Enable keyboard and mouse control</description>
    <message>PortRelay needs permission to create a virtual keyboard and mouse for your Linux desktop. Paired computers still need a separate control permission.</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/portrelay/setup-input</annotate>
  </action>
</policyconfig>
